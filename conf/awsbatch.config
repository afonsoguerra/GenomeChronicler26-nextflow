/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    AWS Batch executor configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Activated automatically when NXF_EXECUTOR=awsbatch is set (by the CDK stack).
    NXF_EXECUTOR is a recognised Nextflow env var that sets process.executor.
    NXF_QUEUE is read here because Nextflow does not auto-map it.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    queue = System.getenv('NXF_QUEUE') ?: null
}

aws {
    region = System.getenv('AWS_DEFAULT_REGION') ?: 'eu-west-2'
    batch {
        volumes = '/tmp'
    }
}
