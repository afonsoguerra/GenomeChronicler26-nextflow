/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    GenomeChronicler-nf base config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default resource allocations for all processes.
    Per-process overrides follow nf-core conventions with labels.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    // Default resources (capped at params.max_*)
    cpus   = { Math.min( 4 * task.attempt, params.max_cpus as int ) }
    memory = { [16.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    time   = { [8.h * task.attempt, params.max_time as nextflow.util.Duration].min() }

    // Error strategy — retry up to 2 times, then finish remaining samples
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 255] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // Process-specific resources
    withLabel: 'process_single' {
        cpus   = { Math.min( 1, params.max_cpus as int ) }
        memory = { [4.GB, params.max_memory as nextflow.util.MemoryUnit].min() }
        time   = { [2.h, params.max_time as nextflow.util.Duration].min() }
    }

    withLabel: 'process_low' {
        cpus   = { Math.min( 2, params.max_cpus as int ) }
        memory = { [8.GB, params.max_memory as nextflow.util.MemoryUnit].min() }
        time   = { [4.h, params.max_time as nextflow.util.Duration].min() }
    }

    withLabel: 'process_medium' {
        cpus   = { Math.min( 8, params.max_cpus as int ) }
        memory = { [32.GB, params.max_memory as nextflow.util.MemoryUnit].min() }
        time   = { [12.h, params.max_time as nextflow.util.Duration].min() }
    }

    withLabel: 'process_high' {
        cpus   = { Math.min( 16, params.max_cpus as int ) }
        memory = { [64.GB, params.max_memory as nextflow.util.MemoryUnit].min() }
        time   = { [24.h, params.max_time as nextflow.util.Duration].min() }
    }
}
