/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    GenomeChronicler-nf Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

plugins {
    id 'nf-amazon'
}

// Global default params
params {
    // Input/output options
    input                = null       // Path to samplesheet CSV
    outdir               = 'results'  // Output directory

    // GenomeChronicler options
    threads              = 4          // GATK threads for genotyping
    no_clean_temp        = false      // Keep temporary/intermediate files

    // Container
    gc_container         = 'ghcr.io/pgp-uk/genomechronicler:latest'

    // Resource defaults
    max_memory           = '64.GB'
    max_cpus             = 16
    max_time             = '24.h'
}

// Load base and module configs
includeConfig 'conf/base.config'

// Container engine profiles
profiles {
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        docker.enabled         = false
    }
    docker {
        docker.enabled         = true
        singularity.enabled    = false
    }
    awsbatch {
        process.executor = 'awsbatch'
    }
    test {
        includeConfig 'conf/test.config'
    }
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Execution reports
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,%cpu,%mem,rss,vmem,peak_rss,peak_vmem'
}

// Manifest
manifest {
    name            = 'genomechronicler-nf'
    author          = 'PGP-UK'
    description     = 'DSL2 Nextflow pipeline for GenomeChronicler personal genome reports'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.09.0'
    version         = '1.0.0'
}
